ADMIN_SETUP_KEY=
# Optional: server-only Groq key. Keep the provider account on its Free plan.
GROQ_API_KEY=

# Stable server-only random key for manual identity fingerprints. Never expose to clients.
VERIFICATION_HASH_KEY=

# Server-only weekly email configuration. Also configure Worker secrets for production.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CARE_EMAIL_ENABLED=false
CARE_EMAIL_FROM=SilverCare <updates@silvercare.care>
# HTTPS origin serving the authenticated app, unsubscribe endpoint and webhook.
CARE_EMAIL_APP_URL=https://silver-bank.s20181076-cfd.workers.dev
